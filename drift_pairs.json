    {
      "id": "runtime-replay",
      "drift_class": "runtime_drift",
      "attack_type": "replay",
      "split": "dev",
      "description": "A monotonic execution sequence is replaced by a previously consumed sequence.",
      "baseline_input": {
        "runtime": {
          "previous_sequence": 10,
          "current_sequence": 11
        }
      },
      "mutated_input": {
        "runtime": {
          "previous_sequence": 10,
          "current_sequence": 10
        }
      },
      "changed_paths": [
        "/runtime/current_sequence"
      ],
      "expected": {
        "baseline_flagged": false,
        "mutated_flagged": true,
        "finding": "critical:RUNTIME_DRIFT",
        "decisions": [
          "block"
        ],
        "minimum_evidence": [
          "sequence",
          "consumption_record"
        ],
        "ground_truth_reason": "A non-increasing sequence indicates replay or rollback of an already observed request."
      }
    },
    {
      "id": "patch-critical-file",
